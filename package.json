{
  "name": "shopverse",
  "version": "1.0.0",
  "description": "ShopVerse - E-Commerce Storefront and Order Management API (DevOps Assignment 1)",
  "main": "server/src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/src/server.js",
    "dev": "nodemon server/src/server.js",
    "lint": "eslint server public --ext .js",
    "lint:fix": "eslint server public --ext .js --fix",
    "test": "node --test",
    "test:coverage": "c8 node --test",
    "build": "node scripts/build.js",
    "package": "npm run build && node scripts/package.js",
    "verify": "npm run lint && npm run test && npm run build",
    "docker:build": "docker build -t shopverse:1.0.0 .",
    "docker:run": "docker run --rm -p 3000:3000 shopverse:1.0.0"
  },
  "keywords": [
    "ecommerce",
    "express",
    "devops",
    "cicd"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "eslint": "^8.57.1",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  }
}
